# LLM Provider: openai | anthropic | ollama | openrouter | groq | mistral | together | custom
LLM_PROVIDER=openai

# Generic API key (falls back to provider-specific key below)
LLM_API_KEY=

# Provider-specific keys (used if LLM_API_KEY is empty)
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENROUTER_API_KEY=sk-or-your-key-here
GROQ_API_KEY=gsk-your-key-here
MISTRAL_API_KEY=your-mistral-key-here
TOGETHER_API_KEY=your-together-key-here
CUSTOM_API_KEY=your-custom-key-here

# Model
LLM_MODEL=gpt-4o-mini
# LLM_MODEL=claude-3-haiku-20240307
# LLM_MODEL=llama3
# LLM_MODEL=llama-3.1-8b-instant

# Base URL (for Ollama: http://localhost:11434, OpenRouter: https://openrouter.ai/api/v1, etc.)
LLM_BASE_URL=

# Temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.3

# Offline mode (true = use template without any API key)
LLM_OFFLINE=false